{:aliases
 {:repl/clj
  {:extra-deps
   {cider/cider-nrepl {:mvn/version "RELEASE"}
    io.github.clojure/clojure-cli.repl-server {:mvn/version "RELEASE"}}
   :main-opts ["-m" "clojure-cli.repl.server" "repl"]}

  :repl/serve
  {:extra-deps
   {cider/cider-nrepl {:mvn/version "RELEASE"}
    io.github.clojure/clojure-cli.repl-server {:mvn/version "RELEASE"}}
   :main-opts ["-m" "clojure-cli.repl.server"]}

  :repl/attach
  {:replace-paths []
   :replace-deps {io.github.clojure/clojure-cli.repl-client {:mvn/version "RELEASE"}}
   :jvm-opts ["--enable-native-access=ALL-UNNAMED"]
   :main-opts ["-m" "clojure-cli.repl.client"]}

  :repl/cljs
  {:extra-deps {org.clojure/clojurescript {:mvn/version "RELEASE"}}
   :main-opts ["-m" "cljs.main"]}}}
